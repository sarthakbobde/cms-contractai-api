# --- Auth: choose one -------------------------------------------------------
# Microsoft Entra ID (recommended for Power Automate / CMS callers)
# JWT_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# JWT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# JWT_AUDIENCE=api://<app-id>
# Shared secret (HS256) - local development
JWT_SECRET=change-me
COMBINE_REQUIRED_ROLE=Documents.Combine
MASK_REQUIRED_ROLE=Documents.Mask
# AUTH_ENABLED=false   # never in production

MAX_COMBINED_SIZE_MB=50
MAX_MASK_FILE_SIZE_MB=25
PUBLIC_BASE_URL=http://localhost:8000
WORK_DIR=./data
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Optional: return Azure Blob SAS download URLs instead of this service's /download endpoint
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_OUTPUT_CONTAINER=output
MASK_CHAR=*
